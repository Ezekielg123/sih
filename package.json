{
  "name": "sih26264-complaint-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "test": "npm --prefix server test",
    "db:init": "npm --prefix server run db:init",
    "db:seed": "npm --prefix server run db:seed"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
